# Leave unset in development: Vite proxies /api and /internal to the API.
# Set it when the console is served from a different origin than the API.
VITE_API_BASE=

# Development only, and never in a deployed build — Vite inlines env values into
# the bundle. A session token the console uses when localStorage is empty, so a
# local console works without pasting anything. Put the real value in
# web/.env.local, which is gitignored.
VITE_DEV_TOKEN=
