# Copy to .env. Every value here must have a typed field in internal/config.
# Nothing outside internal/config may read the environment (CLAUDE.md convention).

# Host ports are deliberately off the defaults: this machine already runs
# a native redis on 6379 and other projects' databases. Override if you like.
POSTGRES_PORT=65432
REDIS_PORT=65379
MINIO_PORT=65000
MINIO_CONSOLE_PORT=65001

DEVSIGNAL_ENV=local
DEVSIGNAL_LOG_LEVEL=debug
DEVSIGNAL_LOG_FORMAT=text          # text locally, json everywhere else

DATABASE_URL=postgres://devsignal:devsignal@localhost:65432/devsignal?sslmode=disable
DATABASE_MAX_CONNS=10              # pods x this must stay under max_connections
DATABASE_MIN_CONNS=2

REDIS_URL=redis://localhost:65379/0

S3_ENDPOINT=http://localhost:65000
S3_BUCKET=devsignal-raw
S3_ACCESS_KEY=devsignal
S3_SECRET_KEY=devsignal123
S3_USE_PATH_STYLE=true

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s               # must be < k8s terminationGracePeriodSeconds

# traces go to stdout until an OTel collector exists (blueprint §28)
OTEL_ENABLED=true
OTEL_EXPORTER=stdout
OTEL_SERVICE_NAME=devsignal
OTEL_SAMPLE_RATIO=1.0              # 1.0 locally; low single digits in prod

# Extraction. An unset key lets the SDK resolve credentials itself (env var, then
# an authenticated profile). EXTRACTION_MODEL is part of the cache key, so
# changing it deliberately invalidates cached extractions rather than mixing them.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
